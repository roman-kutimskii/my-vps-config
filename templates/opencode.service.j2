[Unit]
Description=OpenCode web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ dev_user }}
WorkingDirectory={{ dev_home }}
Environment=HOME={{ dev_home }}
EnvironmentFile=/etc/opencode.env
ExecStart={{ opencode_binary }} web --hostname {{ opencode_host }} --port {{ opencode_port }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
