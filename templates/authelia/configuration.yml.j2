authentication_backend:
  file:
    path: /config/users.yml
    watch: false
    search:
      email: false
      case_insensitive: false

access_control:
  default_policy: deny
  rules:
    - domain: {{ opencode_domain | to_json }}
      policy: one_factor

session:
  secret: {{ vault_authelia_session_secret | to_json }}
  cookies:
    - domain: {{ root_domain | to_json }}
      authelia_url: {{ authelia_url | to_json }}
      default_redirection_url: {{ opencode_url | to_json }}
  redis:
    host: redis
    port: 6379
    password: {{ vault_authelia_redis_password | to_json }}

storage:
  encryption_key: {{ vault_authelia_storage_encryption_key | to_json }}
  local:
    path: /data/db.sqlite3

server:
  endpoints:
    authz:
      forward-auth:
        implementation: ForwardAuth

log:
  level: info
